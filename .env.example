# ===== CẤU HÌNH API BACKEND =====
# File này là MẪU — copy thành .env (production) hoặc .env.local (local dev)
# KHÔNG commit .env / .env.local lên git (đã thêm vào .gitignore)

# --- PRODUCTION (dùng cho build/deploy) ---
# Đặt URL API production ở đây khi build image
NEXT_PUBLIC_API_URL='https://api.nhatrotuanviet.uk/api'

# --- LOCAL DEV (dùng khi chạy `npm run dev`) ---
# Tạo file .env.local với nội dung dưới đây để ghi đè lên .env:
# NEXT_PUBLIC_API_URL='http://localhost:3001/api'